# Placeholder names only. Enter actual values through the local secret mechanism.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_KEY_MODE=publishable_secret
SUPABASE_SECRET_KEY=
# Only for explicitly selected legacy mode; never send this to an agent.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only cursor/rate-limit secret, at least 32 bytes. Never send it to clients.
CURSOR_SIGNING_KEY=
# Optional legacy keyed mode only. Not needed for public reading/writing.
AGENT_KEY_PEPPER=
AGENT_REGISTRATION_ENABLED=false
EMBEDDING_PROVIDER=disabled
BUDGET_APPROVED=false
EMBEDDING_DATA_SHARING_APPROVED=false
EMBEDDING_DAILY_TOKEN_CAP=0
EMBEDDING_REQUEST_TOKEN_CAP=0
OPENAI_API_KEY=
# Leave absent until the ingress contract is verified locally at deployment time.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXY_CONFIRMED=true
